# Copy to .env and fill in your own app registration details.
# .env is git-ignored — never commit real credentials.
#
# The app registration needs these Microsoft Graph APPLICATION permissions,
# both admin-consented:
#   User.Read.All
#   AuditLog.Read.All   <- required for the signInActivity field
#
# The tenant also needs a Microsoft Entra ID P1 or P2 license for
# signInActivity to be populated. See the README.

ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-client-secret-value
